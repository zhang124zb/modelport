{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelPort",
  "version": "0.2.5",
  "identifier": "com.modelport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModelPort",
        "width": 1480,
        "height": 960,
        "minWidth": 920,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#f3f4f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
